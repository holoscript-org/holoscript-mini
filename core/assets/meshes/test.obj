# test.obj — simple unit cube for mesh pipeline testing
# 8 vertices, 12 triangles (2 per face)

v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0
v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0

# Front
f 1 2 3
f 1 3 4
# Back
f 6 5 8
f 6 8 7
# Left
f 5 1 4
f 5 4 8
# Right
f 2 6 7
f 2 7 3
# Top
f 4 3 7
f 4 7 8
# Bottom
f 5 6 2
f 5 2 1
