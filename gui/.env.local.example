# Frontend environment template. Copy to gui/.env.local for local overrides.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, not
# read at runtime — changing this requires a rebuild, and the value is publicly
# visible in the shipped JavaScript. Never put a secret in a NEXT_PUBLIC_ var.

# Origin of the FastAPI backend. Drives every REST call AND the /ws/pipeline
# WebSocket (the ws:// URL is derived from it in lib/api.ts).
#
# Leave unset for local development — it falls back to http://localhost:8000.
# Set it when the frontend and backend are not on the same host, e.g. a Vercel
# deployment talking to a tunnelled local backend:
#
#   NEXT_PUBLIC_API_URL=https://your-subdomain.ngrok-free.app
#
# Must be https:// in any deployed environment: the dashboard uses getUserMedia
# for camera/mic, which browsers block on non-secure origins, and a page served
# over https cannot call an http backend (mixed content).
NEXT_PUBLIC_API_URL=http://localhost:8000
