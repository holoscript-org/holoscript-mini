# HoloScript Mini — environment template.
# Copy to .env and fill in. .env is gitignored; this file is not, so never put
# real secrets here.
#
# Only the keys marked REQUIRED must be set. Everything else has a safe default
# in code, and the value shown is that default.

# ── Secrets (REQUIRED) ───────────────────────────────────────────────────────
GROQ_API_KEY=
POLYPIZZA_API_KEY=

# ── Google Cloud / Vertex AI ─────────────────────────────────────────────────
# REQUIRED to use Gemini. There is deliberately NO default project id: an unset
# GCP_PROJECT disables Vertex AI and falls back to Groq rather than guessing a
# project and billing the wrong account.
#
# Auth is ADC, not an API key:
#   gcloud auth login
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <your-project-id>
#   gcloud services enable aiplatform.googleapis.com --project <your-project-id>
GCP_PROJECT=
GCP_LOCATION=us-central1

# ── Model selection (all optional) ───────────────────────────────────────────
# Two tiers, resolved at call time by llm/gemini_client.py.
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Per-stage overrides. Each wins over its tier default when set — use these to
# downgrade one expensive stage without touching the rest.
#   architect  = passes 7a/7b, the heavy composition work (pro tier)
#   finish     = pass 7c, lighting/camera/summary        (flash tier)
#   intent     = Stage 3 structured intent extraction    (pro tier)
#   optimizer  = Stage 2 prompt cleanup                  (flash tier)
#   critic     = Stage 8 critique/fix loop               (flash tier)
#   verifier   = Stage 8.5 holistic intent check         (flash tier)
# GEMINI_ARCHITECT_MODEL=
# GEMINI_FINISH_MODEL=
# GEMINI_INTENT_MODEL=
# GEMINI_OPTIMIZER_MODEL=
# GEMINI_CRITIC_MODEL=
# GEMINI_VERIFIER_MODEL=

# ── MongoDB Atlas (REQUIRED — an empty KB crashes the parser at startup) ─────
MONGODB_URI=
MONGODB_DB=holoscript
MONGODB_COLLECTION=knowledge_base

# ── Redis (optional — the pipeline degrades gracefully when unreachable) ─────
REDIS_URL=redis://localhost:6379/0
REDIS_ASSET_TTL=604800
REDIS_SCENE_TTL=21600

# ── Semantic parser / embeddings (optional) ──────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_SIMILARITY_THRESHOLD=
# EMBEDDING_TOP_K=

# ── Third-party endpoints (optional — override only for testing/mocking) ─────
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# POLYPIZZA_API_URL=https://api.poly.pizza/v1.1/search/{query}
# Max size of a single downloaded GLB, in bytes. Default 10 MiB.
# POLYPIZZA_MAX_BYTES=10485760
